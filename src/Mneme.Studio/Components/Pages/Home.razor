@page "/"
@inject StudioReadService Read

<PageTitle>Mneme.Studio</PageTitle>

<h1>Mneme.Studio</h1>
<p class="lead">A workbench for the Mneme memory substrate. Use it to dogfood each phase as it ships.</p>

@if (_metrics is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row g-3 my-3">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted">Events</h6>
                    <div class="display-5">@_metrics.TotalEvents</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted">Queued for distillation</h6>
                    <div class="display-5">@_metrics.QueuedForDistillation</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted">Workstreams</h6>
                    <div class="display-5">@_metrics.Workstreams</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted">Revoked</h6>
                    <div class="display-5">@_metrics.Revoked</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <h3>Events by category</h3>
            <table class="table table-sm w-auto">
                <thead><tr><th>Category</th><th class="text-end">Count</th></tr></thead>
                <tbody>
                    @foreach (var kvp in _metrics.ByCategory.OrderByDescending(x => x.Value))
                    {
                        <tr><td>@kvp.Key</td><td class="text-end">@kvp.Value</td></tr>
                    }
                    @if (_metrics.ByCategory.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted">No events yet — head to <a href="ingest">Ingest</a>.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h3>Events by classification</h3>
            <table class="table table-sm w-auto">
                <thead><tr><th>Classification</th><th class="text-end">Count</th></tr></thead>
                <tbody>
                    @foreach (var kvp in _metrics.ByClassification.OrderByDescending(x => x.Value))
                    {
                        <tr><td>@kvp.Key</td><td class="text-end">@kvp.Value</td></tr>
                    }
                    @if (_metrics.ByClassification.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted">No events yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<h3 class="mt-4">Status</h3>
<ul>
    <li>Phase 0 — Contracts: <strong>shipped</strong>.</li>
    <li>Phase 1 — Event log + SQLite: <strong>shipped</strong>.</li>
    <li>Phase 2 — Classification + revocation: <strong>shipped</strong> (classification column, RuleBasedClassifier, LlmClassifier scaffold, IRevocationService, AddMneme DI ergonomic).</li>
    <li>Phase 3 — Projections: <em>pending</em>.</li>
    <li>Phase 4 — Capability-checked query API: <em>pending</em>.</li>
    <li>Phase 5 — Distillation pipeline: <em>pending</em>.</li>
    <li>Phase 6 — Conservative entity resolution: <em>pending</em>.</li>
    <li>Phase 7 — Outcome closure: <em>pending</em>.</li>
    <li>Phase 7.5 — HITL curation: <em>pending</em>.</li>
    <li>Phase 8 — MCP server: <em>pending</em>.</li>
    <li>Phase 9 — Sidecar deployment: <em>pending</em>.</li>
    <li>Phase 10 — Cloud snapshot sync: <em>pending</em>.</li>
    <li>Phase 11 — Vector (sqlite-vec): <em>blocked</em> (waiting on sqlite-vec maturity).</li>
</ul>

@code {
    private StudioMetrics? _metrics;

    protected override async Task OnInitializedAsync()
    {
        _metrics = await Read.GetMetricsAsync();
    }
}
