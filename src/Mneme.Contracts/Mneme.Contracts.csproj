<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mneme.Contracts</PackageId>
    <Title>Mneme.Contracts</Title>
    <Description>Interfaces and DTOs for Mneme — a chronological memory substrate for AI agents. Define IMemoryAgent (ingest), IMemoryQueryAPI (capability-checked queries), CaptureEvent, CapabilityToken.</Description>
    <PackageTags>memory;agent;ai;mcp;knowledge-graph;temporal;contracts</PackageTags>
    <!-- Kept as a separate csproj to enforce the BCL-only allowlist boundary,
         but NOT shipped as a standalone package: its assembly is folded into the
         Mneme package so customers install a single 'Mneme'. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>