<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mneme</PackageId>
    <Title>Mneme</Title>
    <Description>A local-first, .NET-native chronological memory substrate for AI agents. Bi-temporal knowledge graph with epistemic categories (Evidence, Facts, Decisions, Hypotheses, Goals), LLM-powered distillation, workstream isolation, and conservative entity resolution. SQLite-backed.</Description>
    <PackageTags>memory;agent;ai;knowledge-graph;temporal;sqlite;distillation;rag</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="9.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mneme.Contracts\Mneme.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>