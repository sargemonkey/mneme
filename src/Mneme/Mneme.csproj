<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Mneme</PackageId>
    <Title>Mneme</Title>
    <Description>A local-first, .NET-native chronological memory substrate for AI agents. Bi-temporal knowledge graph with epistemic categories (Evidence, Facts, Decisions, Hypotheses, Goals), LLM-powered distillation, workstream isolation, and conservative entity resolution. SQLite-backed.</Description>
    <PackageTags>memory;agent;ai;knowledge-graph;temporal;sqlite;distillation;rag</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Override the transitive SQLitePCLRaw 2.1.6 (SQLite < 3.50.2, CVE-2025-6965 /
         GHSA-2m69-gcr7-jv3q, vulnerable range <= 2.1.11) with the 3.x bundle, which
         ships patched SQLite and is out of the advisory range. Kept on the 8.x line
         of Microsoft.Data.Sqlite to stay net8-friendly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="9.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mneme.Contracts\Mneme.Contracts.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Fold the (non-packable) Mneme.Contracts assembly into this package so
       customers install a single 'Mneme' package. The csproj boundary is kept
       for the BCL-only allowlist enforcement; only the packaging is combined.
       PrivateAssets="all" above suppresses a phantom Mneme.Contracts package
       dependency; this target copies its dll + xml doc into lib/. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeContractsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeContractsInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
                   and '%(ReferenceCopyLocalPaths.NuGetPackageId)' == ''
                   and ('%(ReferenceCopyLocalPaths.Extension)' == '.dll' or '%(ReferenceCopyLocalPaths.Extension)' == '.xml')" />
      <!-- Ensure the Contracts XML doc rides along for IntelliSense even if it
           isn't surfaced via ReferenceCopyLocalPaths on this SDK. -->
      <BuildOutputInPackage Include="$(OutputPath)Mneme.Contracts.xml"
        Condition="Exists('$(OutputPath)Mneme.Contracts.xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>