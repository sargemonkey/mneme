<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mneme.Benchmarks.Perf</RootNamespace>
    <!-- BenchmarkDotNet must run optimized; force Release semantics even
         if invoked under a Debug solution build. -->
    <Optimize>true</Optimize>
    <!-- The library's repo-wide warnings-as-errors policy stays on, but
         BenchmarkDotNet's [Benchmark] methods don't need XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mneme\Mneme.csproj" />
    <ProjectReference Include="..\..\src\Mneme.Contracts\Mneme.Contracts.csproj" />
  </ItemGroup>

</Project>
